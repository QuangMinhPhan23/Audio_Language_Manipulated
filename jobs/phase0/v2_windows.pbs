#!/bin/bash
#PBS -N mw_v2_windows
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -M z5531827@unsw.edu.au

# v2 Step 2: find active 20s windows for each track+instrument. Reads audio from the zip, computes
# per-frame RMS to check activity thresholds. Writes: data/phase0/windows.jsonl
# Set MOISESDB_URL in ~/.musicwhy_secrets or MOISESDB_ZIP for a local zip.
# Needs numpy + soundfile (in sp_bundle). ~240 tracks × audio reads; remote zip may take ~1 h.

source /srv/scratch/z5531827/musicwhy/scripts/_env.sh

echo "=== v2 Step 2: find windows ==="
echo "Started: $(date)  Node: $(hostname)"
mw_stage_bundle || exit 1
cd ${CODE_ROOT}
${PYTHON} -I ${CODE_ROOT}/scripts/phase0v2_stems.py windows || exit 1
echo "Finished: $(date)"
